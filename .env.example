# Connection string del database Neon (Postgres serverless).
# Dashboard Neon -> Project -> Connection Details -> "Pooled connection".
# Deve contenere ?sslmode=require
DATABASE_URL="postgresql://utente:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Password per entrare nell'app (la scegli tu, serve solo a te).
APP_PASSWORD="una-password-lunga-a-piacere"

# Segreto con cui viene firmato il cookie di sessione.
# Generane uno a caso: openssl rand -base64 32
AUTH_SECRET="incolla-qui-32-byte-casuali"

# Solo per lo sviluppo, e solo se apri l'app dal telefono sulla rete di casa.
# Senza, Next blocca il ricaricamento automatico da indirizzi diversi da
# localhost. L'indirizzo lo stampa `npm run dev` accanto a "Network".
# Piu' di uno: separati da virgola.
# DEV_ORIGINS="192.168.1.22"

# Chiave per la lettura dei pasti scritti a parole ("due uova e 80 g di pane").
# Si genera su console.anthropic.com -> API keys. È a consumo, fatturata a
# parte dall'abbonamento a Claude: senza, l'app funziona lo stesso e quel
# tasto spiega cosa manca.
# ANTHROPIC_API_KEY="sk-ant-..."
